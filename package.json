{
  "name": "ferto",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev:worker": "npm run db:migrate:local",
    "dev:worker": "node scripts/local-wrangler.mjs dev",
    "predemo": "npm run demo:prepare",
    "demo": "XDG_CONFIG_HOME=/tmp/ferto-wrangler wrangler dev --local --persist-to .wrangler/demo-state --env-file /dev/null --ip 127.0.0.1 --port \"${FERTO_DEMO_PORT:-8787}\" --var \"APP_ORIGIN:http://127.0.0.1:${FERTO_DEMO_PORT:-8787}\" --var SESSION_SECRET:demo-only",
    "demo:prepare": "npm run build && npm run demo:migrate && npm run demo:seed",
    "demo:migrate": "XDG_CONFIG_HOME=/tmp/ferto-wrangler wrangler d1 migrations apply ferto --local --persist-to .wrangler/demo-state",
    "demo:seed": "XDG_CONFIG_HOME=/tmp/ferto-wrangler wrangler d1 execute ferto --local --persist-to .wrangler/demo-state --file scripts/demo-catalogue.sql",
    "build": "npm run typecheck && vite build",
    "worker:check": "XDG_CONFIG_HOME=/tmp/ferto-wrangler wrangler deploy --dry-run --env-file /dev/null",
    "types:worker": "XDG_CONFIG_HOME=/tmp/ferto-wrangler wrangler types src/worker-configuration.d.ts --include-runtime false --strict-vars false --env-file /dev/null",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p browser/tsconfig.json --noEmit",
    "test": "XDG_CONFIG_HOME=/tmp/ferto-wrangler vitest run",
    "spotify:authorize": "node scripts/spotify-authorize.mjs",
    "db:migrate:local": "node scripts/local-wrangler.mjs d1 migrations apply DB --local",
    "simulate": "node scripts/simulate.mjs",
    "test:simulator": "tsc -p simulation/tsconfig.json --noEmit && node scripts/simulate.mjs --test",
    "test:browser": "playwright test",
    "test:demo": "node --test scripts/demo-smoke.test.mjs",
    "backup": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:list": "node scripts/backup.mjs list",
    "backup:keys": "node scripts/ci-backups.mjs keys",
    "backup:fetch": "node scripts/ci-backups.mjs fetch",
    "backup:restore": "node scripts/ci-backups.mjs restore",
    "ops:status": "node scripts/operations-status.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "recovery:prepare": "node scripts/prepare-recovery.mjs",
    "test:operations": "node --test scripts/backup.test.mjs scripts/release-smoke.test.mjs scripts/deploy-local.test.mjs scripts/recovery.test.mjs scripts/backup-encryption.test.mjs scripts/deploy-ci.test.mjs scripts/operations-usage.test.mjs",
    "test:release": "node --test scripts/release-artifact.test.mjs",
    "verify": "node scripts/verify.mjs",
    "release:prepare": "npm run verify && node scripts/release-artifact.mjs",
    "config:production": "node scripts/deployment-config.mjs --init",
    "secrets:install": "node scripts/check-secrets.mjs --install",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:publication": "node --test scripts/deployment-config.test.mjs scripts/check-secrets.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1"
}
