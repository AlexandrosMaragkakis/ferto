{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ferto",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 3 * * SUN", "*/15 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ferto",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "REFRESH_QUEUE",
				"queue": "ferto-refresh"
			}
		],
		"consumers": [
			{
				"queue": "ferto-refresh",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 8,
				"retry_delay": 30,
				"max_concurrency": 1
			}
		]
	},
	"vars": {
		"SPOTIFY_CLIENT_ID": "REPLACE_WITH_SPOTIFY_CLIENT_ID",
		"OWNER_SPOTIFY_ID": "REPLACE_WITH_OWNER_SPOTIFY_ID",
		"APP_ORIGIN": "http://127.0.0.1:8787"
	}
}
